# Render asigna PORT automáticamente.
PORT=10000

# URL pública del frontend en GitHub Pages. Se usa para redirecciones de Wompi.
FRONTEND_ORIGIN=https://vipexamenesocupacionales.com

# Orígenes permitidos para llamadas del navegador. Separar con comas.
# Incluye el dominio personalizado y, si lo necesitas, la URL github.io.
ALLOWED_ORIGINS=https://vipexamenesocupacionales.com,https://dtalero78.github.io

# Base de datos SQLite. En producción usa un disco persistente de Render.
DATA_DIR=.data
# Genera 32 bytes aleatorios en hexadecimal (64 caracteres) y guárdalos solo en Render.
DATA_ENCRYPTION_KEY=

# mock | live
MEDICONNECTA_MODE=mock
ENABLE_DEMO=false
MEDICONNECTA_BASE_URL=
MEDICONNECTA_TENANT=
MEDICONNECTA_WRITES_ENABLED=false

# URL absoluta HTTPS opcional. Si queda vacía, el frontend usa su ruta local.
PRIVACY_POLICY_URL=

# unconfigured | order-only | required
PAYMENT_POLICY=unconfigured
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Solo true cuando Render/proxy sobrescribe X-Real-IP de forma confiable.
TRUST_PROXY=false

# Notificaciones internas por correo con Brevo.
# La API key real y el correo remitente verificado se configuran solo en Render.
EMAIL_NOTIFICATIONS_ENABLED=false
BREVO_API_KEY=
BOOKING_NOTIFICATION_TO=
EMAIL_FROM_NAME=VIP Salud Ocupacional
EMAIL_FROM_ADDRESS=
